# Endereço de conexão com o banco de dados Postgres
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Chave usada para assinar o cookie de sessão (login).
AUTH_SECRET="uma-chave-secreta-qualquer"

# Token do Vercel Blob, usado para salvar as imagens enviadas nos produtos
BLOB_READ_WRITE_TOKEN="token-do-vercel-blob"
